generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PatientStatus {
  WAITING
  IN_PROGRESS
  IN_EXAMINATION
  WAITING_RESULT
  READY_FOR_DISCHARGE
  DISCHARGED
  TRANSFERRED
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

enum UserRole {
  ADMIN
  MEDICAL
  ADMIN_STAFF
  SUPERVISOR
}

enum UserAuditAction {
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PASSWORD_RESET
}

enum PatientSex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

enum UnitKind {
  EMERGENCY
  OR
  ICU
}

enum BedType {
  STANDARD
  MONITORING
  ISOLATION
}

enum BedStatus {
  FREE
  OCCUPIED
  CLEANING
  MAINTENANCE
  RESERVED
}

enum BedAssignmentEvent {
  ASSIGNED
  TRANSFERRED
  RELEASED
}

model Patient {
  id            String                 @id @default(cuid())
  recordNumber  String                 @unique @map("record_number")
  firstName     String                 @map("first_name")
  lastName      String                 @map("last_name")
  dateOfBirth   DateTime               @db.Date @map("date_of_birth")
  sex           PatientSex             @default(UNKNOWN)
  phone         String                 @unique
  address       String?
  arrivalReason String                 @map("arrival_reason")
  urgencyLevel  Int                    @map("urgency_level")
  status        PatientStatus          @default(WAITING)
  internalNotes String?                @map("internal_notes")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  reservations  Reservation[]
  statusHistory PatientStatusHistory[]
  currentBed    Bed?
  bedHistory    BedAssignmentHistory[]

  @@index([lastName, firstName])
  @@index([status])
  @@map("patients")
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      UnitKind
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  beds      Bed[]

  @@index([kind])
  @@map("units")
}

model Bed {
  id               String                 @id @default(cuid())
  unitId           String                 @map("unit_id")
  unit             Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  code             String
  type             BedType                @default(STANDARD)
  status           BedStatus              @default(FREE)
  currentPatientId String?                @unique @map("current_patient_id")
  currentPatient   Patient?               @relation(fields: [currentPatientId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  history          BedAssignmentHistory[] @relation("BedHistoryBed")
  transfersFrom    BedAssignmentHistory[] @relation("BedHistoryFrom")
  transfersTo      BedAssignmentHistory[] @relation("BedHistoryTo")

  @@unique([unitId, code])
  @@index([status])
  @@index([unitId, status])
  @@map("beds")
}

model BedAssignmentHistory {
  id          String             @id @default(cuid())
  bedId       String             @map("bed_id")
  bed         Bed                @relation("BedHistoryBed", fields: [bedId], references: [id], onDelete: Cascade)
  patientId   String             @map("patient_id")
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  event       BedAssignmentEvent
  fromBedId   String?            @map("from_bed_id")
  fromBed     Bed?               @relation("BedHistoryFrom", fields: [fromBedId], references: [id], onDelete: SetNull)
  toBedId     String?            @map("to_bed_id")
  toBed       Bed?               @relation("BedHistoryTo", fields: [toBedId], references: [id], onDelete: SetNull)
  actorUserId String             @map("actor_user_id")
  actor       User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([bedId, createdAt])
  @@index([patientId, createdAt])
  @@map("bed_assignment_history")
}

model Reservation {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service         String
  practitioner    String?
  examination     String?
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @map("duration_minutes")
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([scheduledAt, status])
  @@map("reservations")
}

model User {
  id            String                 @id @default(cuid())
  email         String                 @unique
  passwordHash  String                 @map("password_hash")
  firstName     String                 @map("first_name")
  lastName      String                 @map("last_name")
  role          UserRole
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  statusChanges PatientStatusHistory[]
  adminActions  UserAuditLog[]         @relation("UserAuditActor")
  auditEvents   UserAuditLog[]         @relation("UserAuditTarget")
  bedActions    BedAssignmentHistory[]

  @@map("users")
}

model UserAuditLog {
  id           String          @id @default(cuid())
  actorUserId  String          @map("actor_user_id")
  actor        User            @relation("UserAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUserId String          @map("target_user_id")
  target       User            @relation("UserAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  action       UserAuditAction
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("user_audit_logs")
}

model PatientStatusHistory {
  id          String        @id @default(cuid())
  patientId   String        @map("patient_id")
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  previousStatus PatientStatus? @map("previous_status")
  status      PatientStatus
  changedById String        @map("changed_by_id")
  changedBy   User          @relation(fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime      @default(now()) @map("changed_at")

  @@index([patientId, changedAt])
  @@map("patient_status_history")
}
