# medora-api/.gitignore

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Database
*.db
*.sqlite
*.sqlite3

# Prisma
prisma/migrations/dev/

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
.history/

# Temporary files
tmp/
temp/
*.tmp